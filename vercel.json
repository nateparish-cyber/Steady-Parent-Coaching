{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "steadyparentingcoach.com" }],
      "destination": "https://www.steadyparentingcoach.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "functions": {
    "api/chat.js": { "maxDuration": 30 }
  }
}
